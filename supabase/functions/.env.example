# Edge Function secret'ları — `supabase secrets set --env-file ...` ile yüklenir. Bu dosyada GERÇEK DEĞER YOKTUR.
# SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY Supabase tarafından otomatik sağlanır.

# Herkese açık site adresi (yönlendirmeler, bağlantılar)
PUBLIC_SITE_URL=
# CORS izinli origin listesi (virgülle ayrılmış)
ALLOWED_ORIGINS=
# pg_cron → Edge Function çağrıları için paylaşılan gizli değer (Vault'taki cron_secret ile aynı)
CRON_SECRET=
# Teslimat QR imzalama anahtarı (en az 32 rastgele bayt, base64)
QR_HMAC_SECRET=
# Google Routes API sunucu anahtarı (yalnız sunucu; IP/API kısıtlı)
GOOGLE_MAPS_SERVER_KEY=
# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# https://api.iyzipay.com (canlı) veya https://sandbox-api.iyzipay.com (test)
IYZICO_BASE_URL=
# iyzico buyer.identityNumber zorunlu alanı için kullanılacak değer (iyzico'nun TCKN toplanmayan durumlar için belgelediği değer)
IYZICO_BUYER_IDENTITY_NUMBER=
# iyzico iade isteğinde gönderilecek sunucu IP'si
IYZICO_REQUEST_IP=
# FCM HTTP v1 servis hesabı JSON'u (tek satır)
FCM_SERVICE_ACCOUNT_JSON=
# Resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_UNSUBSCRIBE_SECRET=
