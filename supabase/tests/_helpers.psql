-- Test yardımcıları. Her test dosyası BEGIN ... ROLLBACK içinde çalışır; oluşturulan geçici veriler kalıcı olmaz.
-- Bu dosya yalnız geçici test veritabanında kullanılır.
\set ON_ERROR_STOP on
set client_min_messages = warning;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated, service_role;

create or replace function tests.reset_role() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.headers', '{"user-agent":"kapinda-tests","x-request-id":"test"}', true);
end $$;

create or replace function tests.as_user(p_uid uuid) returns void language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, true);
end $$;

create or replace function tests.as_anon() returns void language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
end $$;

create or replace function tests.as_service() returns void language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
end $$;

-- Beklenen hata: SQL çalıştırılır, belirtilen mesaj/SQLSTATE ile hata vermesi beklenir.
create or replace function tests.assert_raises(p_sql text, p_expected text, p_label text) returns void language plpgsql as $$
declare
  v_msg text;
  v_state text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_msg = message_text, v_state = returned_sqlstate;
    if p_expected is null or v_msg like p_expected or v_state = p_expected then
      raise notice 'ok   - %', p_label;
      return;
    end if;
    raise exception 'FAIL - % : beklenen "%", alınan "%" (%)', p_label, p_expected, v_msg, v_state;
  end;
  raise exception 'FAIL - % : hata bekleniyordu ama sorgu başarılı oldu', p_label;
end $$;

create or replace function tests.assert_true(p_cond boolean, p_label text) returns void language plpgsql as $$
begin
  if p_cond is distinct from true then
    raise exception 'FAIL - %', p_label;
  end if;
  raise notice 'ok   - %', p_label;
end $$;

create or replace function tests.assert_eq(p_actual anyelement, p_expected anyelement, p_label text) returns void language plpgsql as $$
begin
  if p_actual is distinct from p_expected then
    raise exception 'FAIL - % : beklenen %, alınan %', p_label, p_expected, p_actual;
  end if;
  raise notice 'ok   - %', p_label;
end $$;

-- Geçici kullanıcı (güncel yasal doküman sürümleriyle)
create or replace function tests.create_user(p_email text, p_referral text default null) returns uuid language plpgsql as $$
declare
  v_id uuid;
  v_consents jsonb;
begin
  select jsonb_object_agg(document_type, version) into v_consents from public.legal_documents where is_current;
  insert into auth.users (email, email_confirmed_at, raw_user_meta_data)
  values (p_email, now(), jsonb_build_object('full_name', 'Test ' || split_part(p_email, '@', 1), 'phone', '0532 000 00 01',
    'consents', v_consents, 'referral_code', p_referral))
  returning id into v_id;
  return v_id;
end $$;

create or replace function tests.hopa_area() returns uuid language sql as $$
  select id from public.coverage_areas where slug = 'hopa';
$$;

create or replace function tests.create_vendor(p_owner uuid, p_name text) returns uuid language plpgsql as $$
declare
  v_id uuid;
begin
  insert into public.vendors (slug, name, business_type, phone, tax_number, address_text, lat, lng, coverage_area_id, status, is_open)
  values (public._slugify(p_name) || '-' || substr(md5(random()::text), 1, 6), p_name, 'market', '04663510000', '1234567890',
    'Test adresi', 41.4100, 41.4300, tests.hopa_area(), 'active', true)
  returning id into v_id;
  insert into public.vendor_members (vendor_id, user_id) values (v_id, p_owner);
  insert into public.user_roles (user_id, role) values (p_owner, 'vendor') on conflict do nothing;
  return v_id;
end $$;

create or replace function tests.create_courier(p_user uuid, p_max int default 1) returns uuid language plpgsql as $$
declare
  v_id uuid;
begin
  insert into public.couriers (user_id, display_name, phone, vehicle_type, coverage_area_id, status, availability, max_active_orders)
  values (p_user, 'Kurye Test Kullanici', '05320000002', 'motosiklet', tests.hopa_area(), 'active', 'available', p_max)
  returning id into v_id;
  insert into public.user_roles (user_id, role) values (p_user, 'courier') on conflict do nothing;
  return v_id;
end $$;

create or replace function tests.create_product(p_vendor uuid, p_price numeric, p_stock int default 100, p_category text default 'temel-gida')
returns uuid language plpgsql as $$
declare
  v_id uuid;
begin
  insert into public.products (vendor_id, category_id, name, price, stock_quantity, track_stock)
  values (p_vendor, (select id from public.categories where slug = p_category), 'Urun ' || p_price, p_price, p_stock, true)
  returning id into v_id;
  return v_id;
end $$;

create or replace function tests.create_address(p_user uuid, p_lat double precision default 41.4200, p_lng double precision default 41.4400)
returns uuid language plpgsql as $$
declare
  v_id uuid;
begin
  insert into public.addresses (user_id, district_id, neighborhood, street, building, recipient_name, phone, lat, lng)
  values (p_user, (select id from public.districts where slug = 'hopa'), 'Merkez Mahallesi', 'Cumhuriyet Caddesi', '12',
    'Test Alici', '+905320000003', p_lat, p_lng)
  returning id into v_id;
  return v_id;
end $$;

-- Teklif (service) + sipariş (müşteri) + ödeme onayı (service). Rol postgres'e döner.
create or replace function tests.place_order(p_customer uuid, p_vendor uuid, p_address uuid, p_items jsonb, p_pay boolean default true)
returns uuid language plpgsql as $$
declare
  v_quote public.delivery_fees;
  v_res jsonb;
  v_pay public.payments;
begin
  perform tests.as_service();
  v_quote := public.create_delivery_fee_quote(p_customer, p_vendor, p_address, 3.4, 'google_maps');
  perform tests.as_user(p_customer);
  v_res := public.create_order(v_quote.id, p_items, 'cash', null, false);
  perform tests.as_service();
  if p_pay and (v_res ->> 'payment_required')::boolean then
    v_pay := public.begin_delivery_payment((v_res ->> 'order_id')::uuid, p_customer);
    perform public.attach_payment_token(v_pay.id, 'tok_' || v_pay.id);
    perform public.confirm_delivery_payment(v_pay.id, 'iyz_' || v_pay.id, v_pay.amount, '{}'::jsonb);
  end if;
  perform tests.reset_role();
  return (v_res ->> 'order_id')::uuid;
end $$;

-- Siparişi vendor_pending → ready_for_pickup
create or replace function tests.vendor_prepare(p_vendor_user uuid, p_order uuid) returns void language plpgsql as $$
begin
  perform tests.as_user(p_vendor_user);
  perform public.vendor_update_order_status(p_order, 'vendor_accepted');
  perform public.vendor_update_order_status(p_order, 'preparing');
  perform public.vendor_update_order_status(p_order, 'ready_for_pickup');
  perform tests.reset_role();
end $$;

-- Müşteri için QR üretimi (Edge Function'ın yaptığı gibi nonce hash saklanır)
create or replace function tests.issue_qr(p_order uuid, p_customer uuid, p_nonce text, p_ttl int default 30) returns uuid language plpgsql as $$
declare
  t public.qr_tokens;
begin
  perform tests.as_service();
  t := public.issue_delivery_qr(p_order, p_customer, public.sha256_hex(p_nonce), p_ttl);
  perform tests.reset_role();
  return t.id;
end $$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
do $$ begin perform tests.reset_role(); end $$;
set client_min_messages = notice;
