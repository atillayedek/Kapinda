# Müşteri web uygulaması ortam değişkenleri (build zamanı). Bu dosyada GERÇEK DEĞER YOKTUR.
# Yalnız herkese açık (publishable/anon) anahtarlar kullanılır. service_role anahtarı ASLA buraya yazılmaz.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=https://kapinda.site
# Google Maps JavaScript API (HTTP referrer kısıtlı tarayıcı anahtarı)
VITE_GOOGLE_MAPS_API_KEY=
# Firebase web yapılandırması (FCM Web Push)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
