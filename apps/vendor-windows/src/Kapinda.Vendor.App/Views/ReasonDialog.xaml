<Window x:Class="Kapinda.Vendor.App.Views.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CreamBrush}" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" />
        <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,8,0,8" />
        <TextBox x:Name="ReasonBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500" VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Vazgeç" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Onayla" Style="{StaticResource DangerButton}" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
