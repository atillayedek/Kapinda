    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource NullVis}}" />
                <TextBlock Text="{Binding Info}" Style="{StaticResource InfoText}" Visibility="{Binding Info, Converter={StaticResource NullVis}}" />
                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Left">
                    <StackPanel>
                        <CheckBox Content="Yeni siparişte sesli uyarı" IsChecked="{Binding SoundAlerts}" Margin="0,0,0,8" />
                        <CheckBox Content="Yeni siparişte görev çubuğunu yakıp söndür" IsChecked="{Binding FlashWindow}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Version, StringFormat=Sürüm {0}}" Style="{StaticResource Muted}" />
                        <Button Content="Çıkış yap" Style="{StaticResource DangerButton}" Command="{Binding SignOutCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
